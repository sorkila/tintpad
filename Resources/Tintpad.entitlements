<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- NOT sandboxed: the core function (arbitrary shell execution + Apple
         events to terminals) is incompatible with App Sandbox. Distributed
         direct via Developer ID, not the Mac App Store. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
