<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Tintpad</string>
    <key>CFBundleDisplayName</key>
    <string>Tintpad</string>
    <key>CFBundleIdentifier</key>
    <string>com.sorkila.tintpad</string>
    <key>CFBundleExecutable</key>
    <string>Tintpad</string>
    <key>CFBundleIconFile</key>
    <string>Tintpad</string>
    <key>CFBundleIconName</key>
    <string>Tintpad</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Accessory app: menu-bar only, no Dock icon. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Required so AppleScript-driven terminals (iTerm2/Terminal.app) get a
         proper Automation (Apple Events) TCC prompt with this explanation. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Tintpad opens your terminal and runs the selected coding agent at the chosen repository.</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Sörkila</string>
    <!-- Sparkle auto-update. Replace SUPublicEDKey with the public key printed
         by Sparkle's generate_keys (the private key stays in your Keychain). -->
    <key>SUFeedURL</key>
    <string>https://tintpad.com/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_SPARKLE_PUBLIC_ED_KEY</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
